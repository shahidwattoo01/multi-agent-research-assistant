# --- Credentials -----------------------------------------------------------
# Option A: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Option B: Google Gemini (free tier) — set this and leave ANTHROPIC_API_KEY blank
# GOOGLE_API_KEY=

# Optional: use Tavily instead of DuckDuckGo for search
# TAVILY_API_KEY=

# --- Models ----------------------------------------------------------------
# Claude models (used when ANTHROPIC_API_KEY is set):
RA_MODEL=claude-opus-5-5
RA_WORKER_MODEL=claude-opus-5-5
# Gemini free-tier models (used when GOOGLE_API_KEY is set, ANTHROPIC_API_KEY blank):
# RA_MODEL=gemini-1.5-flash
# RA_WORKER_MODEL=gemini-1.5-flash

# Per-agent reasoning effort: low | medium | high | xhigh | max
RA_PLANNER_EFFORT=high
RA_RESEARCHER_EFFORT=medium
RA_CRITIC_EFFORT=high
RA_WRITER_EFFORT=high
RA_SUMMARIZER_EFFORT=low
RA_ENABLE_FALLBACKS=true

# --- Workflow --------------------------------------------------------------
RA_MAX_SUBTASKS=6
RA_MAX_REVISIONS=2
RA_MAX_TOOL_CALLS_PER_TASK=8
RA_APPROVAL_THRESHOLD=0.75
RA_PARALLEL_RESEARCH=true

# --- Tools -----------------------------------------------------------------
RA_SEARCH_PROVIDER=duckduckgo
RA_SEARCH_RESULTS=5
RA_SUMMARIZE_THRESHOLD_CHARS=6000

# --- Memory ----------------------------------------------------------------
RA_MEMORY_DIR=.research_memory
RA_PERSIST_MEMORY=true
RA_DUPLICATE_SIMILARITY=0.82
